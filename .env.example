# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for canonicals, sitemap,
# robots and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact email (Resend) -------------------------------------------------
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=
# Verified sender. Until you verify a domain, Resend's onboarding address works.
CONTACT_FROM_EMAIL="AA Solutions <onboarding@resend.dev>"

# --- Cloudflare Turnstile (spam protection) --------------------------------
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional, pick one or none) --------------------------------
# Plausible: set your domain, e.g. aasolutions.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4: measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
